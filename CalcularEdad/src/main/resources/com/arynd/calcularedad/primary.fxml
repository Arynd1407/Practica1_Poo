<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.arynd.calcularedad.PrimaryController"
            prefWidth="460" prefHeight="270">

    <children>

        <Label text="Fecha de nacimiento"
               layoutX="35"
               layoutY="40"
               style="-fx-font-size: 15px;"/>

        <TextField fx:id="txtFecha"
                   layoutX="230"
                   layoutY="35"
                   prefWidth="170"
                   promptText="dd/MM/aaaa"
                   alignment="CENTER"
                   style="-fx-font-size: 14px;"/>

        <Button text="Calcular"
                layoutX="65"
                layoutY="100"
                prefWidth="100"
                prefHeight="35"
                onAction="#calcular"/>

        <Button text="Limpiar"
                layoutX="185"
                layoutY="100"
                prefWidth="100"
                prefHeight="35"
                onAction="#limpiar"/>

        <Label fx:id="lblResultado"
               layoutX="30"
               layoutY="175"
               prefWidth="400"
               alignment="CENTER"
               style="-fx-font-size: 16px; -fx-font-style: italic;"/>

    </children>

</AnchorPane>