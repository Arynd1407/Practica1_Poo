<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.arynd.multiplicar.PrimaryController"
            prefWidth="350" prefHeight="440">

    <children>

        <Label text="Tabla del:"
               layoutX="30" layoutY="35"/>

        <TextField fx:id="txtNumero"
                   layoutX="30" layoutY="75"
                   prefWidth="80"/>

        <Button text="Calcular"
                layoutX="220" layoutY="35"
                prefWidth="100"
                onAction="#calcular"/>

        <Button text="Limpiar"
                layoutX="220" layoutY="85"
                prefWidth="100"
                onAction="#limpiar"/>

        <TextArea fx:id="txtResultado"
                  layoutX="30" layoutY="150"
                  prefWidth="290" prefHeight="250"
                  editable="false"
                  wrapText="true"/>

    </children>

</AnchorPane>